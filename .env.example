# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- Required ---
# Model provider. The investigator and structurer models are OpenRouter slugs.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Shared secret for the webhook bearer check. Pick any high-entropy string; the same value
# is interpolated into the Grafana contact point from the container env at provisioning time.
GRAFANA_WEBHOOK_SECRET=pick_a_long_random_string
# Read-only Viewer service-account token for the Grafana MCP. Do NOT set by hand: run
# `bin/mint-sa-token` after the stack is up (the demo Grafana has no data volume, so re-mint
# after every `docker compose up`).
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# --- Backends (defaults match the offset-port demo stack) ---
GRAFANA_URL=http://localhost:13000
TEMPO_URL=http://localhost:13200
PROM_DS_UID=prometheus          # datasource UID; must match your provisioned Prometheus datasource
LOKI_DS_UID=loki                # datasource UID; must match your provisioned Loki datasource
MCP_GRAFANA_BIN=mcp-grafana     # mcp-grafana v0.17.0 binary, resolved on PATH

# --- Paths (optional; sensible defaults relative to the repo root) ---
WEBAPP_SRC=./demo-webapp        # the read_source tool is scoped to this directory only
SAMPLES_DIR=./samples           # where the agent writes last-card.md / last-run.json

# --- Models (optional; OpenRouter slugs, defaults shown) ---
INVESTIGATOR_MODEL=openrouter/anthropic/claude-sonnet-4.5   # capable tool-caller for the ReAct loop
STRUCTURING_MODEL=openrouter/openai/gpt-5-mini              # cheap pass that structures the verdict

# --- Optional ---
SLACK_BOT_TOKEN=                # omit both and the card logs to stdout instead of posting
SLACK_CHANNEL=
MASTRA_PORT=14111               # the webhook server port
MAX_STEPS=10                    # hard cap on the ReAct loop
SERVICE=demo-webapp             # default service for the run.ts CLI
